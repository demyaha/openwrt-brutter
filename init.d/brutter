#!/bin/sh /etc/rc.common
# Ping Brutter: faster UDP source ports for CS and Valorant.
START=96
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/brutter -config /etc/ping-brutter.json
	# Bounds the Go heap on small routers; the program itself needs far less.
	procd_set_param env GOMEMLIMIT=48MiB
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 20
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
